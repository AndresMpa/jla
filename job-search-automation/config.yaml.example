# ---------------------------------------------------------------------------
# job-search-automation SYSTEM configuration
#
# Copy this file to config.yaml and edit it — config.yaml is gitignored.
# This file only holds settings that apply to every run (Ollama connection,
# which providers are on, scoring weights, the database).
#
# It does NOT hold who you're searching jobs for anymore — that lives in
# profiles/<name>.yaml, one file per person/role. See
# profiles/profile.yaml.example. See README.md for the full field list.
# ---------------------------------------------------------------------------

# Local LLM used to score and draft outreach for each listing.
ollama:
  # Leave empty/null to auto-detect (Docker host vs localhost).
  # Overridable at runtime with the OLLAMA_URL env var.
  url: null
  model: qwen2.5:14b
  # Used only for CV tailoring (cv.py, one call per "Send tailored CV"
  # click) - scoring/outreach (scoring.py, one call per job listing) always
  # use `model` above. Leave empty/null to just use `model` for everything.
  # Since tailoring runs on demand rather than once per job in a batch, a
  # bigger/slower model here is usually worth it if you have one available.
  # Overridable at runtime with the OLLAMA_CV_MODEL env var.
  cv_model: null
  timeout: 300 # seconds
  # Hybrid-reasoning models (Qwen3, DeepSeek-R1, ...) emit a long <think>
  # block before answering unless told not to — usually just wasted time
  # for a JSON scoring task, and often what's actually behind a timeout.
  # false = skip thinking (faster, recommended on CPU-only setups).
  # true  = let the model think (slower, occasionally better reasoning).
  # No-op on models that don't support toggling it.
  # Overridable at runtime with the OLLAMA_THINK env var (1/true/yes).
  think: false

# Enable/disable individual providers without touching any code.
providers:
  remoteok: true
  remotive: true
  weworkremotely: true
  python_jobs: true
  vuejobs: false
  hackernews: true
  arbeitnow: true
  greenhouse: true
  workday: false # off until real tenant/site values are added below

# WeWorkRemotely fetches one RSS feed per category listed here.
weworkremotely:
  categories:
    - remote-full-stack-programming-jobs
    - remote-back-end-programming-jobs
    - remote-front-end-programming-jobs
    - remote-devops-sysadmin-jobs

# Greenhouse-hosted company career boards (public JSON API, no auth needed).
# Add a company by adding one entry here - no code changes needed. Verify
# the token first at https://boards.greenhouse.io/<board_token> since some
# companies migrate off Greenhouse and the token silently 404s.
greenhouse:
  companies:
    - name: Celonis
      board_token: celonis
    - name: Databricks
      board_token: databricks

# Workday-hosted company career boards (public internal JSON API, no auth).
# Empty by default - Workday has no predictable token-from-company-name
# convention, so tenant/site/wd_server must come from a real job link, e.g.:
#   https://cisco.wd1.myworkdayjobs.com/en-US/External/job/...
#           ^tenant  ^wd_server        ^site
# Add entries here (and flip providers.workday to true above) once confirmed:
#   companies:
#     - name: Cisco
#       tenant: cisco
#       site: External
#       wd_server: wd1
workday:
  companies: []

# How listings are scored (0-10) and which ones make it into the reports.
# Applies the same way to every profile.
scoring:
  min_score_to_keep: 6
  fit_weight: 0.4 # score = fit * fit_weight + income * income_weight
  income_weight: 0.6

# Base directory for per-profile reports: each profile's CSV/Markdown are
# written to <output_base_dir>/<profile-name>/.
output_base_dir: profiles/output

# Postgres connection used to persist scored listings (consumed by the
# job-listings-app frontend through the API). Leave empty to disable the
# database and only write CSV/Markdown. Rows are keyed by (profile, url),
# so the same listing can be scored independently for each profile.
# Overridable at runtime with the DATABASE_URL env var.
database:
  url: postgresql+psycopg://jobs:jobs@localhost:5432/jobs
